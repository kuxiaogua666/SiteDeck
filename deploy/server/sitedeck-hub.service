[Unit]
Description=SiteDeck Hub (private backend)
After=network.target

[Service]
Type=simple
User=sitedeck-hub
Group=sitedeck-hub
RootDirectory=/root/sitedeck
WorkingDirectory=/
ExecStart=/bin/site-hub serve --listen 127.0.0.1:48765 --registration-file /secrets/hub.key --admin-file /secrets/hub-admin.key --state /state/hub-state.json
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=+/state
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
MemoryMax=256M
TasksMax=128
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target
