[Unit]
Description=SiteDeck public WSS gateway
After=network.target sitedeck-hub.service
Requires=sitedeck-hub.service

[Service]
Type=simple
RuntimeDirectory=sitedeck-gateway
ExecStartPre=/usr/sbin/nginx -t -c /root/sitedeck/nginx/nginx.conf
ExecStart=/usr/sbin/nginx -c /root/sitedeck/nginx/nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -t -c /root/sitedeck/nginx/nginx.conf
ExecReload=/usr/sbin/nginx -c /root/sitedeck/nginx/nginx.conf -s reload
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/sitedeck/logs /run/sitedeck-gateway /var/lib/nginx /var/log/nginx
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_CHOWN CAP_KILL
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
MemoryMax=128M
TasksMax=32
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
