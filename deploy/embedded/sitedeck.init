#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
BASE=/lj/sitedeck
# Compatibility for installations already using the previous data location.
if [ ! -x "$BASE/site-agent" ] && [ -x /lj/open-endless/site-agent ]; then
    BASE=/lj/open-endless
fi

start_service() {
    procd_open_instance
    procd_set_param command "$BASE/site-agent" run
    procd_set_param nice 10
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$BASE/site-agent.json"
    procd_close_instance
}
